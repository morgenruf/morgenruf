{
  "name": "@morgenruf/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && tsc -b",
    "preview": "node scripts/nginx-preview.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "pnpm --workspace-root format",
    "format:check": "pnpm --workspace-root format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-top-loading-bar": "^3.0.2",
    "@tanstack/react-query": "^5.105.3",
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0",
    "lucide-react": "^1.68.0",
    "sonner": "^2.0.7",
    "recharts": "^3.8.0",
    "react-hook-form": "^7.91.0",
    "@hookform/resolvers": "^7.0.5",
    "zod": "^4.6.7",
    "tw-animate-css": "^1.4.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@tanstack/react-start": "1.169.5",
    "@tanstack/react-router": "1.170.46"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "shadcn": "^4.22.1",
    "@playwright/test": "^1.65.0"
  }
}
