# Access lines as one JSON object each, with the same field names the backend
# uses, so Loki can chart status and latency. No client address and no query
# string: logs are readable by everyone with Grafana access, and sign-in codes
# travel in query strings.
map $http_x_request_id $req_id {
    "~^[A-Za-z0-9._-]{8,128}$" $http_x_request_id;
    default $request_id;
}

# The path as the client asked for it (not $uri, which reads /_shell.html
# after the SPA fallback), without the query string. The public feed URL is
# its own token, so that segment is hidden.
map $request_uri $log_path {
    "~^/feed/" "/feed/:token";
    "~^(?<request_path>[^?]*)" $request_path;
}

map $status $log_level {
    "~^5" ERROR;
    "~^4" WARNING;
    default INFO;
}

# $request_time is seconds with millisecond precision ("0.045"); this turns it
# into whole milliseconds ("45") without leading zeros, so it is a JSON number.
map $request_time $request_ms {
    "~^0\.0*(?<ms>[0-9]+)$" $ms;
    "~^(?<sec>[1-9][0-9]*)\.(?<frac>[0-9]{3})$" $sec$frac;
    default 0;
}

log_format json_access escape=json
    '{"time":"$time_iso8601","level":"$log_level","logger":"nginx.access",'
    '"message":"$request_method $log_path $status",'
    '"method":"$request_method","path":"$log_path","status":$status,'
    '"duration_ms":$request_ms,"bytes":$body_bytes_sent,'
    '"request_id":"$req_id","user_agent":"$http_user_agent"}';

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index _shell.html;
    include /etc/nginx/snippets/security-headers.conf;

    # Keep the original public host and TLS scheme through the extra proxy hop.
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_scheme;
    proxy_http_version 1.1;
    proxy_read_timeout 300s;
    # One id per request, shared with the backend so both log lines match.
    proxy_set_header X-Request-ID $req_id;

    access_log /var/log/nginx/access.log json_access;

    location = /frontend-healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # Exact /dashboard still consumes existing Slack login links; nested pages belong to React.
    location = /dashboard { proxy_pass ${BACKEND_URL}; }
    location = /dashboard/logout { proxy_pass ${BACKEND_URL}; }
    location = /dashboard/open-in-slack { proxy_pass ${BACKEND_URL}; }

    location = /install { proxy_pass ${BACKEND_URL}; }
    location = /oauth/callback { proxy_pass ${BACKEND_URL}; }

    location = /email/subscribe { proxy_pass ${BACKEND_URL}; }
    location = /email/unsubscribe { proxy_pass ${BACKEND_URL}; }

    location = /connect/zoom/start { proxy_pass ${BACKEND_URL}; }
    location = /connect/zoom/callback { proxy_pass ${BACKEND_URL}; }

    location = /healthz { proxy_pass ${BACKEND_URL}; }
    location = /openapi.json { proxy_pass ${BACKEND_URL}; }

    # These namespaces never fall back to HTML, including unknown endpoints.
    location = /dashboard/api { proxy_pass ${BACKEND_URL}; }
    location = /api { proxy_pass ${BACKEND_URL}; }
    location = /slack { proxy_pass ${BACKEND_URL}; }
    location = /google { proxy_pass ${BACKEND_URL}; }
    location = /webhooks { proxy_pass ${BACKEND_URL}; }

    location /dashboard/api/ { proxy_pass ${BACKEND_URL}; }
    location /api/ { proxy_pass ${BACKEND_URL}; }
    location /slack/ { proxy_pass ${BACKEND_URL}; }
    location /google/ { proxy_pass ${BACKEND_URL}; }
    location /webhooks/ { proxy_pass ${BACKEND_URL}; }
    # Celebration banner images: Slack fetches these from the app's own URL.
    location /celebrations/banners/ { proxy_pass ${BACKEND_URL}; }
    location /celebrations/cards/ { proxy_pass ${BACKEND_URL}; }

    location = /mcp { proxy_buffering off; proxy_pass ${BACKEND_URL}; }
    location /mcp/ { proxy_buffering off; proxy_pass ${BACKEND_URL}; }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control 'public, max-age=31536000, immutable';
        include /etc/nginx/snippets/security-headers.conf;
    }

    location /static/ { try_files $uri =404; }

    location = /_shell.html {
        add_header Cache-Control 'no-cache';
        include /etc/nginx/snippets/security-headers.conf;
    }
    location / { try_files $uri $uri/ /_shell.html; }
}

map $http_x_forwarded_proto $forwarded_scheme {
    default $scheme;
    https https;
    http http;
}
