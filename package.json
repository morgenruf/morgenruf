{
  "name": "morgenruf",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @morgenruf/frontend dev",
    "build": "pnpm --filter @morgenruf/frontend build",
    "typecheck": "pnpm --filter @morgenruf/frontend typecheck",
    "lint": "pnpm --filter @morgenruf/frontend lint",
    "test": "pnpm --filter @morgenruf/frontend test",
    "format:check": "prettier --check frontend",
    "format": "prettier --write frontend",
    "api:generate": "node scripts/api.mjs",
    "api:check": "node scripts/api.mjs --check",
    "test:e2e": "pnpm --filter @morgenruf/frontend test:e2e"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "prettier": "^3.8.3",
    "swagger-typescript-api": "13.13.0"
  }
}
