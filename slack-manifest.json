{
  "display_information": {
    "name": "Morgenruf",
    "description": "Daily standups for Slack \u2014 open-source & self-hosted",
    "background_color": "#0d1117",
    "long_description": "Morgenruf runs your team's daily standups directly in Slack \u2014 no expensive SaaS required.\r\n \r\nEach day at your configured time, it DMs team members 3 questions, \r\ncollects answers privately, and posts a clean summary to your team channel.\r\n \r\n Features:\r\n \u2022 Configurable schedule (time, timezone, days)\r\n \u2022 Per-project tagging for automated reporting\r\n \u2022 Blocker detection and highlighting\r\n \u2022 Open source (MIT) \u2014 self-host or use our hosted version at morgenruf.dev"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "Morgenruf",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/morgenruf",
        "description": "Morgenruf commands and help",
        "should_escape": false
      },
      {
        "command": "/morgenruf-standup",
        "description": "Start your daily standup now",
        "should_escape": false
      },
      {
        "command": "/morgenruf-skip",
        "description": "Skip today's standup",
        "should_escape": false
      },
      {
        "command": "/morgenruf-kudos",
        "description": "Give a shoutout to a teammate",
        "usage_hint": "@teammate [message]",
        "should_escape": false
      },
      {
        "command": "/standup",
        "description": "Start your daily standup now (alias)",
        "should_escape": false
      },
      {
        "command": "/skip",
        "description": "Skip today's standup (alias)",
        "should_escape": false
      },
      {
        "command": "/kudos",
        "description": "Give a shoutout to a teammate (alias)",
        "usage_hint": "@teammate [message]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://api.morgenruf.dev/oauth/callback"
    ],
    "scopes": {
      "bot": [
        "commands",
        "app_mentions:read",
        "chat:write",
        "channels:read",
        "groups:read",
        "im:write",
        "im:history",
        "im:read",
        "mpim:write",
        "mpim:history",
        "users:read",
        "users:read.email",
        "users.profile:read",
        "emoji:read",
        "team:read"
      ]
    },
    "pkce_enabled": false
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://api.morgenruf.dev/slack/events",
      "bot_events": [
        "app_home_opened",
        "app_mention",
        "message.im",
        "member_joined_channel"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://api.morgenruf.dev/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": true
  }
}
