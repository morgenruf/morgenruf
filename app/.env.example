# Morgenruf self-hosted configuration.
# Copy to .env and fill in, then: docker compose up -d

# Postgres password for the bundled database container.
DB_PASSWORD=change-me

# From your Slack app at https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Signs dashboard sessions and the OAuth state token. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leaving this unset means OAuth state is signed with a per-process random
# key, so any in-flight install loses its callback on restart.
FLASK_SECRET_KEY=

# Public URL Slack redirects back to. Must match your Slack app's
# redirect URL exactly.
APP_URL=http://localhost:3000

# Optional: transactional email for digests. Leave blank to disable.
RESEND_API_KEY=

# Optional: Zoom account linking. Each person connects their own account, and
# a coffee chat then gets a meeting scheduled for the time the pair agree.
# Leave both blank and the feature is absent: no button, nothing to fail.
#
# Create a user-managed OAuth app at https://marketplace.zoom.us/develop/create
# with redirect URL <APP_URL>/connect/zoom/callback and the scopes
# meeting:write:meeting and user:read:user.
#
# An unpublished app installs only for users inside your own Zoom account.
# Letting other workspaces connect requires publishing it, which needs Zoom's
# review.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Optional: verbose logging. Set to DEBUG for debug logs and Flask debug
# output. Anything else, or unset, means INFO.
LOG_LEVEL=

# Optional: where to email when a scheduled job fails. Blank disables it.
MORGENRUF_OPS_EMAIL=

# Optional: error reporting.
SENTRY_DSN=

# Local development only: Flask's debugger. Deliberately not exposed by the
# Helm chart.
FLASK_DEBUG=
