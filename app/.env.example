# Morgenruf self-hosted configuration.
# Copy to .env and fill in, then: docker compose up -d

# Postgres password for the bundled database container.
DB_PASSWORD=change-me

# From your Slack app at https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Signs dashboard sessions and the OAuth state token. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leaving this unset means OAuth state is signed with a per-process random
# key, so any in-flight install loses its callback on restart.
FLASK_SECRET_KEY=

# Public URL Slack redirects back to. Must match your Slack app's
# redirect URL exactly.
APP_URL=http://localhost:3000

# Optional: transactional email for digests. Leave blank to disable.
RESEND_API_KEY=
